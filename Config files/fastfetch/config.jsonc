
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/Lockwallpaper/goku.png",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  
    "display": {
        "separator": "  »  ",
        "color": {
            "separator": "magenta"
        },
        "key": {
            "type": "string",
            "paddingLeft": 2
        }
    },

    "modules": [
    {
        "type": "title",
        "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    "break",
    {
        "type": "os",
        "key": "OS          ",
        "keyColor": "red"
    },
    {
        "type": "host",
        "key": "Machine     ",
        "keyColor": "green"
    },
    {
        "type": "kernel",
        "key": "Kernel      ",
        "keyColor": "magenta"
    },
    {
        "type": "wm",
        "key": "WM          ",
        "keyColor": "blue"
    },
    {
        "type": "cpu",
        "key": "CPU         ",
        "keyColor": "yellow"
    },
    {
        "type": "gpu",
        "key": "GPUs        ",
        "keyColor": "blue"
    },
    {
        "type": "memory",
        "key": "Memory      ",
        "keyColor": "magenta"
    },
    {
        "type": "disk",
        "key": "Storage     ",
        "keyColor": "green"
    },
    {
        "type": "monitor",
        "key": "Monitor     ",
        "keyColor": "yellow"
    },
    {
        "type": "uptime",
        "key": "Uptime      ",
        "keyColor": "red"
    },
    {
        "type": "command",
        "key": "OS Age      ",
        "keyColor": "yellow",
        "text": "bash -c 'first=$(grep -m1 \"\\[ALPM\\] installed\" /var/log/pacman.log 2>/dev/null | sed -n \"s/^\\[\\([^]]*\\)\\].*/\\1/p\"); if [ -n \"$first\" ]; then days=$(( ($(date +%s)-$(date -d \"$first\" +%s))/86400 )); printf \"%s days*\\n\" \"$days\"; else echo unknown; fi'",
        "timeout": 1000
    },
    "break",
    {
        "type": "colors",
        "paddingLeft": 34,
        "symbol": "circle"
    }
    ]
}
