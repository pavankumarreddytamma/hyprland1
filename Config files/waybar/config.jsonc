{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/info", "group/utils"],
    "margin-left": 12,
    "margin-right": 12,
    "margin-top": 8,

    "group/cpubar": {
	"orientation": "horizontal",
	"modules": [
		"cpu",
		"temperature"
		]
	},

    "group/info": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "battery"
        ]
    },

    "group/utils": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "backlight"
        ]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄",
        "tooltip-format": "{capacity}%"
    },

    "clock": {
        "format": "{:%a %d %b %I:%M %p}",
        "tooltip": false
    },

    "cpu": {
	    "interval": 1,
	    "format": "{icon0}{icon1}{icon2}{icon3} {usage:>2}%",
	    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "memory": {
	    "interval": 30,
	    "format": "{used:0.1f}G"
    },   

    "temperature": {
		"format": "{temperatureC}°C"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "nmgui",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected"
    },  

    "backlight": {
	    "device": "intel_backlight",
	    "format": "󰃠",
        "tooltip": false
    },


    "pulseaudio": {
	    "format":"{icon}",
	    "format-bluetooth": "{icon}",
	    "format-muted": "",
	    "format-icons": {
		    "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
		    "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		    "headphone": "",
		    "hands-free": "󰂑",
		    "headset": "󰂑",
		    "phone": "",
		    "phone-muted": "",
		    "portable": "",
		    "car": "",
		    "default": ["", ""]
	    },
	    "scroll-step": 1,
	    "on-click": "pavucontrol",
        "tooltip": false
    }
}