{
    "layer": "bottom",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "backlight", "battery"],
    "height": 26,

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "󰂄",
        "tooltip-format": "Battery: {capacity}%\nHealth: {health}"
    },

    "clock": {
        "format": "{:%d %B %A %I:%M %p}",
	"tooltip-format": false
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "{ifname}",
        "format-linked": "linked",
        "format-disconnected": "disconnected",
        "format-disabled": "disabled",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        //"on-click": "nmgui",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "󰈀  {ifname}",
        "tooltip-format-disconnected": "Disconnected"
    },  

    "backlight": {
	    "device": "intel_backlight",
	    "format": "󰃠",
	    "tooltip-format": "Brightness: {percent}%"
    },


    "pulseaudio": {
	    "format":"{icon}",
	    "format-bluetooth": "{icon}",
	    "format-muted": "",
	    "format-icons": {
		    "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
		    "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		    "headphone": "",
		    "hands-free": "󰂑",
		    "headset": "󰂑",
		    "phone": "",
		    "phone-muted": "",
		    "portable": "",
		    "car": "",
		    "default": ["", ""]
	    },
	    "scroll-step": 1,
	    //"on-click": "pavucontrol",
        "tooltip-format": "Volume: {volume}%"
    },

    "hyprland/workspaces": {
        "on-scroll-up": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"e+1\" }))'",
        "on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"e-1\" }))'"
    }
}
