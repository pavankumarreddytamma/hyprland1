configuration {
    modi: "drun";
    show-icons: false;
    display-drun: "";
    drun-display-format: "{name}";
    show-match: false;
    font: "JetBrainsMono Nerd Font 10";
}

@theme "/dev/null"

* {
    background-color: transparent;
    text: #d67b7b;
    bg: #1a1a1c;
}

window {
    width:            350;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: @bg;
    border: 1px;
    border-color: @text;
    //border-radius: 11px;
}

inputbar {
    margin:           16px 16px 16px 16px;
    padding:          12px 12px 12px 12px;
    background-color: #4e0a0a;
    //border-radius:    12px;
    children:         [ prompt,entry ];
    border: 1px;
    border-color: @text;
}

prompt {
    text-color:       @text;
    padding:          0px 12px 0px 5px;
}

entry {
    text-color:       @text;
    placeholder:      "Search Apps...";
    placeholder-color: @text;
}

listview {
    lines:            6;
    columns:          1;
    fixed-height:     false;
    margin:           0px 16px 16px 16px;
}

element {
    padding:          10px 12px 10px 12px;
    //border-radius:    10px;
}

element selected {
    background-color: #4e0a0a;
    border: 1px;
    border-color: @text;
}

element-icon {
    size:             22px;
    margin:           0 12px 0 0;
}

element-text {
    vertical-align:   0.5;
    color:            @text;
}
