configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    show-match: false;
    font: "JetBrainsMono Nerd Font 10";
}

@theme "/dev/null"

* {
    background-color: transparent;
    text: #8CA4C6;
    bg: #1b1d2a;
    hg: #292c40;
}

window {
    width:            350;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: @bg;
    border: 2px;
    border-color: @text;
    border-radius: 11px;
    //border-radius: 11px;
}

inputbar {
    margin:           16px 16px 16px 16px;
    padding:          12px 12px 12px 12px;
    background-color: @hg;
    //border-radius:    12px;
    children:         [ prompt,entry ];
    border: 2px;
    border-color: @text;
    border-radius: 11px;
}

prompt {
    text-color:       @text;
    padding:          0px 12px 0px 5px;
}

entry {
    text-color:       @text;
    placeholder:      "Search Apps...";
    placeholder-color: @text;
}

listview {
    lines:            6;
    columns:          1;
    fixed-height:     true;
    margin:           0px 16px 16px 16px;
}

element {
    padding:          10px 12px 10px 12px;
    //border-radius:    10px;
}

element selected {
    background-color: @hg;
    border: 2px;
    border-radius: 11px;
    border-color: transparent;
}

element-icon {
    size:             22px;
    margin:           0 12px 0 0;
}

element-text {
    vertical-align:   0.5;
    color:            @text;
}
