configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    show-match: false;
    font: "JetBrainsMono Nerd Font 10";
}

@theme "/dev/null"

* {
    background-color: transparent;
}

window {
    width:            350px;
}

mainbox {
    children:         [ inputbar, listview ];
    background-color: rgb(57, 23, 47);
    border-color: transparent;
    border-radius: 12px;
}

inputbar {
    margin:           16px 16px 16px 16px;
    padding:          12px 12px 12px 12px;
    background-color: rgb(77, 31, 63);
    border-radius:    12px;
    children:         [ prompt,entry ];
}

prompt {
    text-color:       rgba(225, 215, 215, 0.6);
    padding:          0px 12px 0px 5px;
}

entry {
    text-color:       rgba(225, 215, 215);
    placeholder:      "Search Apps...";
    placeholder-color: rgba(225, 215, 215, 0.6);
}

listview {
    lines:            6;
    columns:          1;
    fixed-height:     false;
    margin:           0px 16px 16px 16px;
}

element {
    padding:          8px 12px 8px 12px;
    border-radius:    10px;
}

element selected {
    background-color: rgb(94, 38, 77);
    text-color:       #e1d7d7;
}

element-icon {
    size:             22px;
    margin:           0 12px 0 0;
}

element-text {
    vertical-align:   0.5;
    color:            rgb(225, 215, 215);
}

